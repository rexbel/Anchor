# Anchor configuration. Every variable is optional: with none set, Anchor runs
# on deterministic triage and the seeded in-memory store.

# --- System of record (MongoDB on the GB10) ---
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=anchor

# --- Local reasoning model: any OpenAI-compatible server (vLLM, Ollama, NIM) ---
# ANCHOR_LLM_BASE_URL=http://localhost:8000/v1
# ANCHOR_LLM_MODEL=qwen-3.8-27b        # use the exact model name your server serves
# ANCHOR_LLM_API_KEY=
# ANCHOR_LLM_TIMEOUT_MS=12000

# --- Digital Twin voice: Kokoro (OpenAI-compatible /audio/speech, e.g. Kokoro-FastAPI) ---
# ANCHOR_TTS_BASE_URL=http://localhost:8880/v1
# ANCHOR_TTS_MODEL=kokoro
# ANCHOR_TTS_VOICE=af_heart

# --- Digital Twin: voice-cloning TTS (services/twin-tts: Sesame CSM-1B or XTTS-v2) ---
# POST {text, language, speaker_wav: <base64 WAV>, speaker_text?} -> audio. See README "Digital Twin voice".
# ANCHOR_TWIN_TTS_URL=http://localhost:8020/twin

# --- Demo voice: seed a Digital Twin from a consented reference mounted on the box ---
# Never set these without the voice owner's informed consent. All four are required.
# ANCHOR_DEMO_TWIN_WAV=/bundle/self_ref.wav          # 16-bit PCM WAV, 3-60 s (3-12 s for CSM)
# ANCHOR_DEMO_TWIN_TEXT=/bundle/self_ref.txt         # exact transcript of that WAV
# ANCHOR_DEMO_TWIN_PATIENT=demo-patient-complex
# ANCHOR_DEMO_TWIN_CONSENTED_BY=Full Name

# --- OpenClaw hook: receives a bounded review task after an escalation commits ---
# OPENCLAW_HOOK_URL=http://localhost:18789/hooks/anchor   # example; use your OpenClaw hook endpoint
# OPENCLAW_HOOK_TOKEN=

# --- Demo mode: enables the reset button. Set to false outside demos. ---
# ANCHOR_DEMO_MODE=true
